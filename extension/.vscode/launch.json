{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Anvil on flask-3.1.3",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../../flask-3.1.3"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
