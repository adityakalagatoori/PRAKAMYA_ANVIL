{
  "name": "anvil-agent",
  "displayName": "Anvil — coding agent on TrueForge",
  "description": "Editor-native coding agent whose loop runs on TrueForge: inline edits, multi-file agent mode, budgeted context assembly, per-hunk diff review, streaming and cancellation, model fallback.",
  "version": "0.1.0",
  "publisher": "anvil-forgeathon",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anvil",
          "title": "Anvil",
          "icon": "media/anvil.svg"
        }
      ]
    },
    "views": {
      "anvil": [
        {
          "type": "webview",
          "id": "anvil.agentPanel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "anvil.inlineEdit",
        "title": "Anvil: Inline Edit Selection",
        "category": "Anvil"
      },
      {
        "command": "anvil.openPanel",
        "title": "Anvil: Open Agent Panel",
        "category": "Anvil"
      },
      {
        "command": "anvil.cancel",
        "title": "Anvil: Cancel Running Generation",
        "category": "Anvil",
        "icon": "$(debug-stop)"
      },
      {
        "command": "anvil.setup",
        "title": "Anvil: Register Agents & MCP Server with TrueForge",
        "category": "Anvil"
      },
      {
        "command": "anvil.undoLast",
        "title": "Anvil: Undo Last Applied Change",
        "category": "Anvil"
      },
      {
        "command": "anvil.revertRun",
        "title": "Anvil: Revert All Changes From Last Run",
        "category": "Anvil"
      },
      {
        "command": "anvil.acceptHunk",
        "title": "Accept hunk",
        "category": "Anvil"
      },
      {
        "command": "anvil.rejectHunk",
        "title": "Reject hunk",
        "category": "Anvil"
      },
      {
        "command": "anvil.showContext",
        "title": "Anvil: Preview Context Pack for a Query",
        "category": "Anvil"
      },
      {
        "command": "anvil.reindex",
        "title": "Anvil: Rebuild Code Index",
        "category": "Anvil"
      },
      {
        "command": "anvil.acceptAll",
        "title": "Anvil: Accept All Hunks",
        "category": "Anvil",
        "icon": "$(check-all)"
      },
      {
        "command": "anvil.rejectAll",
        "title": "Anvil: Reject All Hunks",
        "category": "Anvil",
        "icon": "$(close-all)"
      },
      {
        "command": "anvil.acceptHunkAtCursor",
        "title": "Anvil: Accept Hunk at Cursor",
        "category": "Anvil",
        "icon": "$(check)"
      },
      {
        "command": "anvil.rejectHunkAtCursor",
        "title": "Anvil: Reject Hunk at Cursor",
        "category": "Anvil",
        "icon": "$(x)"
      },
      {
        "command": "anvil.openAuditLog",
        "title": "Anvil: Open Audit Log",
        "category": "Anvil"
      }
    ],
    "keybindings": [
      {
        "command": "anvil.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "anvil.openPanel",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "anvil.cancel",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "anvil.running"
      },
      {
        "command": "anvil.acceptHunkAtCursor",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "anvil.reviewing"
      },
      {
        "command": "anvil.rejectHunkAtCursor",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "anvil.reviewing"
      },
      {
        "command": "anvil.acceptAll",
        "key": "ctrl+alt+shift+y",
        "mac": "cmd+alt+shift+y",
        "when": "anvil.reviewing"
      },
      {
        "command": "anvil.rejectAll",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+shift+n",
        "when": "anvil.reviewing"
      }
    ],
    "configuration": {
      "title": "Anvil",
      "properties": {
        "anvil.trueforgeUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the local TrueForge server.",
          "scope": "machine"
        },
        "anvil.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Models configured in TrueForge as 'provider/model', in priority order. The first is primary; the rest are automatic fallbacks."
        },
        "anvil.mcpPort": {
          "type": "number",
          "default": 7337,
          "description": "Port for Anvil's MCP server (127.0.0.1).",
          "scope": "machine"
        },
        "anvil.mcpPublicHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host TrueForge should use to reach Anvil's MCP server (use host.docker.internal if TrueForge runs in Docker).",
          "scope": "machine"
        },
        "anvil.contextBudgetTokens": {
          "type": "number",
          "default": 6000,
          "description": "Token budget for automatically retrieved context."
        },
        "anvil.retries": {
          "type": "number",
          "default": 2,
          "description": "Retries (with backoff) on the same model before falling back."
        },
        "anvil.iterationLimit": {
          "type": "number",
          "default": 60,
          "description": "Max tool-loop iterations per agent turn."
        },
        "anvil.modelParams": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object"
          },
          "markdownDescription": "Per-model parameter overrides merged into the agent's `model.params`, keyed by model id. Example: `{\"ollama/qwen3-4b\": {\"reasoning_effort\": \"none\"}}` turns off long thinking for a small local reasoning model."
        },
        "anvil.passSecretsToCommands": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Pass credential-looking environment variables (`*_API_KEY`, `*_TOKEN`, `*SECRET*`, `*PASSWORD*`) to commands the agent runs. Off by default so a prompt-injected command cannot exfiltrate them."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "anvil.acceptHunkAtCursor",
          "when": "resourceScheme == anvil-proposed && anvil.reviewing",
          "group": "navigation@1"
        },
        {
          "command": "anvil.rejectHunkAtCursor",
          "when": "resourceScheme == anvil-proposed && anvil.reviewing",
          "group": "navigation@2"
        },
        {
          "command": "anvil.acceptAll",
          "when": "resourceScheme == anvil-proposed && anvil.reviewing",
          "group": "navigation@3"
        },
        {
          "command": "anvil.rejectAll",
          "when": "resourceScheme == anvil-proposed && anvil.reviewing",
          "group": "navigation@4"
        }
      ],
      "view/title": [
        {
          "command": "anvil.cancel",
          "when": "view == anvil.agentPanel && anvil.running",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "anvil.acceptHunk",
          "when": "false"
        },
        {
          "command": "anvil.rejectHunk",
          "when": "false"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "node esbuild.mjs --tests && node out-test/e2e.live.cjs",
    "test": "node esbuild.mjs --tests && node --test out-test/*.test.cjs",
    "test:integration": "node integration/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.184.1",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.4.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted (Restricted Mode) workspaces Anvil can read and explain code but will not write files or run commands.",
      "restrictedConfigurations": [
        "anvil.models",
        "anvil.modelParams",
        "anvil.trueforgeUrl",
        "anvil.mcpPublicHost",
        "anvil.mcpPort",
        "anvil.passSecretsToCommands"
      ]
    },
    "virtualWorkspaces": false
  }
}
